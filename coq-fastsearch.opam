opam-version: "2.0"
name: "coq-fastsearch"
version: "dev"
synopsis: "Fast search command for Coq"
description: """
An isolated implementation of the Coq Search command with result limiting
and prioritization. Provides the FastSearch vernacular command with the
same syntax as the built-in Search.
"""
maintainer: "Vasilii Nesterov"
license: "LGPL-2.1-only"
depends: [
  "coq" {>= "8.20" & < "8.21~"}
  "ocaml"
]
build: [
  [make "-j%{jobs}%"]
]
install: [
  [make "install"]
]
tags: [
  "logpath:FastSearch"
]
