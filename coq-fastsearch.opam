opam-version: "2.0"
name: "coq-fastsearch"
version: "dev"
synopsis: "Faster search command for Coq"
description: "Faster search command for Coq."
maintainer: "Vasilii Nesterov"
authors: ["Vasilii Nesterov"]
homepage: "https://github.com/vasnesterov/coq-fastsearch"
bug-reports: "https://github.com/vasnesterov/coq-fastsearch/issues"
license: "LGPL-2.1-only"
depends: [
  "coq" {>= "8.20" & < "8.21~"}
  "ocaml"
]
build: [
  [make "-j%{jobs}%"]
]
install: [
  [make "install"]
]
tags: [
  "logpath:FastSearch"
]
